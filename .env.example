# The template for local development. Copy this to .dev.vars and fill in the
# values; .dev.vars is gitignored, this file is committed and must never
# contain a real key.
#
# These four are read at the moment of a request by the signup function
# (src/pages/api/subscribe.ts), never compiled into the build. In production
# they are set in the Cloudflare dashboard, NOT in a file.

# The whole service-account JSON on ONE line, wrapped in single quotes.
# Must never be placed in public/ — that folder is served to the world.
GOOGLE_SERVICE_ACCOUNT_JSON=''

# The id from the sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
# The service-account email above needs Editor access to that sheet.
GOOGLE_SHEET_SIGNUPS=

# Brevo API key (Brevo → SMTP & API → API keys).
BREVO_API_KEY=

# The Brevo list that signups are added to. Empty means Brevo is skipped
# entirely: registrations still reach the sheet, but nobody is emailed.
BREVO_LIST_SIGNUPS=
