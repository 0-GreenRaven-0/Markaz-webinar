---
import "../styles/global.css";
import { metaPixelId, gtmContainerId, gaMeasurementId, googleAdsId } from "../data/config";

interface Props {
	/** Shown in the browser tab and in search results. */
	title: string;
	/** One-sentence summary for search engines and link previews. */
	description?: string;
	/** Page language, e.g. "en" or "ar". */
	lang?: string;
	/** Text direction: "ltr" for English, "rtl" for Arabic. */
	dir?: "ltr" | "rtl";
}

const {
	title,
	description = "",
	lang = "en",
	dir = "ltr",
} = Astro.props;

/*
	Records how this visitor arrived, once per browsing session, so the signup
	sheet can carry a "Traffic Source" column without a visitor who clicks an
	internal link (say, from /index to the form) losing the ad click that
	actually brought them here. First touch wins: the sessionStorage check at
	the top means a later page view in the same session never overwrites it.

	Checked in this order, and the order matters:

	1. utm_source/utm_medium — if a campaign was deliberately tagged, that is
	   the most specific, intentional signal, so it is trusted first and never
	   overridden by a click id the platform auto-appends alongside it (Google
	   Ads auto-tagging + a manual UTM suffix both land on the same link).
	2. gclid/gbraid/wbraid — Google only ever attaches one of these to a PAID
	   Google Ads click; an organic search result never gets one. Safe to
	   state outright as "Google Ads".
	3. fbclid — by contrast, Facebook attaches this to ANY link opened inside
	   Facebook, Instagram or Messenger, an organic share exactly as much as a
	   paid ad. Labelling it "Facebook Ads" would overstate how many of these
	   were actually paid, so it stays neutral: "Facebook / Instagram".
	4. The referring site's domain — skipped when it is this site's own
	   domain, which only ever means an internal navigation (not a real
	   referral) happened to be the first page view counted this session.
	5. "Direct" if none of the above apply.

	Read back by SignupForm.astro at submit time and sent to /api/subscribe as
	traffic_source, which writes it into the sheet's last column.
*/
const trafficSourceJs = `(function () {
	var KEY = "markaz:traffic_source";
	try {
		if (window.sessionStorage.getItem(KEY)) return;
	} catch (e) {
		return;
	}
	var params = new URLSearchParams(window.location.search);
	var source = "";
	var utmSource = params.get("utm_source");
	if (utmSource) {
		source = utmSource.trim().toLowerCase();
		var medium = params.get("utm_medium");
		if (medium) source += " / " + medium.trim().toLowerCase();
	} else if (params.get("gclid") || params.get("gbraid") || params.get("wbraid")) {
		source = "Google Ads";
	} else if (params.get("fbclid")) {
		source = "Facebook / Instagram";
	} else if (document.referrer) {
		try {
			var refHost = new URL(document.referrer).hostname.replace(/^www\\./, "");
			var selfHost = window.location.hostname.replace(/^www\\./, "");
			source = refHost && refHost !== selfHost ? refHost + " (referral)" : "Direct";
		} catch (e) {
			source = "Referral";
		}
	} else {
		source = "Direct";
	}
	try {
		window.sessionStorage.setItem(KEY, source);
	} catch (e) {
		/* private mode or blocked storage - traffic_source submits empty */
	}
})();`;

/*
	Google Tag Manager, base code, exactly as Google supplies it with the
	container id substituted. Built as a string and written with set:html for
	the same reason as the Meta Pixel snippet just below — see its comment.

	Google's own install instructions put this snippet as high in <head> as
	possible, so it loads ahead of the Meta Pixel rather than after it.
*/
const gtmCode = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${gtmContainerId}');`;

/*
	Google Analytics (gtag.js), base code, exactly as Google supplies it with
	the measurement id substituted. Separate from Google Tag Manager above —
	this was handed over as its own snippet, so it is installed as its own
	snippet rather than folded into the GTM one.

	Built as a string and written with set:html for the same reason as the
	other two snippets on this page — see the Meta Pixel comment below.
*/
const gaCode = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${gaMeasurementId}');`;

/*
	Google Ads conversion tracking, base code, exactly as Google supplies it
	with the conversion id substituted. A third, separate tag — not Google
	Analytics above (that id starts "G-") — handed over as its own snippet, so
	it is installed as its own snippet rather than folded into the other two.

	Built as a string and written with set:html for the same reason as the
	other snippets on this page — see the Meta Pixel comment below.
*/
const googleAdsCode = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${googleAdsId}');`;

/*
	Meta Pixel, base code, exactly as Meta supplies it with the id substituted.

	It is built as a string and written with set:html on purpose. Putting the
	code between <script> tags in the markup instead wraps it in {`...`}, which
	Astro emits literally — the browser then evaluates a template string and
	discards it, so the pixel silently never loads.
*/
const pixelCode = `!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '${metaPixelId}');
fbq('track', 'PageView');`;
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		{/*
			Records the visitor's traffic source for the signup sheet — see the
			comment above trafficSourceJs. Runs before anything else so it has the
			original landing URL's query string, not whatever a later page strips.
		*/}
		<script is:inline set:html={trafficSourceJs} />

		{/*
			Google Tag Manager, base code. As high in <head> as it can sit without
			coming before charset/viewport — those two have to stay first so the
			browser reads the page's encoding before anything else. is:inline for
			the same reason as the Meta Pixel below: Astro would otherwise defer it
			as a module and change when it actually runs.
		*/}
		{gtmContainerId && <script is:inline set:html={gtmCode} />}

		{/*
			Google Analytics (gtag.js), base code. Two pieces, in the order Google
			supplies them: the loader script tagged with the measurement id, then
			the inline config call. is:inline on both for the same reason as the
			rest of this page's tracking snippets — Astro would otherwise bundle or
			defer them.
		*/}
		{gaMeasurementId && (
			<script
				is:inline
				async
				src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
			/>
		)}
		{gaMeasurementId && <script is:inline set:html={gaCode} />}

		{/*
			Google Ads conversion tracking, base code. Same two-piece pattern as
			Google Analytics just above — its own loader script, then its own
			inline config call, exactly as Google supplies it.
		*/}
		{googleAdsId && (
			<script
				is:inline
				async
				src={`https://www.googletagmanager.com/gtag/js?id=${googleAdsId}`}
			/>
		)}
		{googleAdsId && <script is:inline set:html={googleAdsCode} />}

		<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
		<link rel="apple-touch-icon" href="/icon-180.png" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:type" content="website" />
		<slot name="head" />

		{/*
			Meta Pixel, base code. is:inline keeps it exactly as Meta supplies it —
			Astro would otherwise bundle it into a module, which defers it and
			changes when fbq exists for any later event calls.

			It loads on every page, including the privacy and terms pages, which is
			what Meta's own setup expects. The id lives in config.ts; emptying it
			there removes the script entirely.
		*/}
		{metaPixelId && <script is:inline set:html={pixelCode} />}
	</head>
	<body>
		{/*
			Google Tag Manager (noscript). Google's own install instructions put
			this as the very first thing inside <body>, ahead of everything else
			including the Meta Pixel's own noscript fallback.
		*/}
		{
			gtmContainerId && (
				<noscript>
					<iframe
						src={`https://www.googletagmanager.com/ns.html?id=${gtmContainerId}`}
						height="0"
						width="0"
						style="display:none;visibility:hidden"
						title="Google Tag Manager"
					/>
				</noscript>
			)
		}
		{
			metaPixelId && (
				<noscript>
					<img
						height="1"
						width="1"
						style="display:none"
						alt=""
						src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
					/>
				</noscript>
			)
		}
		<slot />
	</body>
</html>
