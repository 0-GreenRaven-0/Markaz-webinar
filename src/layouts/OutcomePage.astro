---
import BaseLayout from "./BaseLayout.astro";
import EdgeDecor from "../components/EdgeDecor.astro";
import SiteFooter from "../components/SiteFooter.astro";

/**
 * The shared frame for the two pages a visitor lands on AFTER registering:
 * /check-email and /confirm.
 *
 * Both are a single short message on an otherwise empty page, so they get the
 * same centred panel rather than the landing page's run of sections. The
 * faceted edges carry over from the landing page so the visitor can see they
 * are still on the same site.
 *
 * Neither page is any use to a search engine, and /confirm carries someone's
 * email address in the URL, so both are kept out of the index.
 */
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<meta slot="head" name="robots" content="noindex, nofollow" />

	<div class="outcome">
		<EdgeDecor seed={3} />

		<main class="outcome__content">
			<div class="container outcome__inner">
				<slot />
			</div>
		</main>
	</div>
</BaseLayout>

<SiteFooter />

<style>
	.outcome {
		position: relative;
		overflow-x: clip;
		/* Fills the screen on a short page so the footer does not ride up under
		   a two-line message. */
		min-height: 70vh;
		display: grid;
		align-items: center;
	}

	.outcome__content {
		position: relative;
		z-index: 1;
		padding-block: var(--section-pad);
	}

	.outcome__inner {
		max-width: var(--measure);
		display: grid;
		justify-items: center;
		gap: var(--space-md);
		text-align: center;
	}
</style>
