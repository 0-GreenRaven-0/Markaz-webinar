---
import OutcomePage from "../layouts/OutcomePage.astro";
import { site, metaPixelId } from "../data/config";

/**
 * Where the signup form sends people the moment their registration is saved.
 *
 * It asks nothing and calls nothing — no form, no API. Its whole job is to say
 * the confirmation email is on its way, and to head off the most common reason
 * people think it never arrived.
 */

/*
	Meta Pixel calls, built as a string and written with set:html for the same
	reason as BaseLayout.astro's pixelCode — see its comment. This page needs
	the pixel id itself (not just the booleans the old version used) to
	re-supply Advanced Matching right before firing Lead/Qualified_Lead — see
	the long comment inside the script for why.
*/
const checkEmailPixelJs = `
try {
	var pixelId = "${metaPixelId}";

	/*
		Advanced Matching: a hashed email and phone, handed over by
		SignupForm.astro via sessionStorage right after a successful submit
		(see the comment there — it hashes with SHA-256 client-side, the raw
		address never touches storage), plus the persistent external_id that
		BaseLayout.astro generates once per browser and keeps in
		localStorage — see pixelCode there. Re-calling fbq('init', ...) with
		this data updates what every event fired AFTER this point on THIS
		page is matched against. That is the documented way the Pixel JS SDK
		accepts matching data that only becomes known partway through a
		visit — it does not create a second pixel or a duplicate PageView.

		This is the single biggest lever for Event Match Quality: the
		browser-only signals every event already carries automatically (IP,
		user agent, fbp/fbc) are a much weaker match than a hashed email or
		phone, because those are what actually lets Meta connect the event to
		a real person it already knows from somewhere else.
	*/
	var em = sessionStorage.getItem("markaz:em");
	var ph = sessionStorage.getItem("markaz:ph");
	sessionStorage.removeItem("markaz:em");
	sessionStorage.removeItem("markaz:ph");
	var eid = "";
	try {
		eid = window.localStorage.getItem("markaz:eid") || "";
	} catch (e) {
		/* private mode or blocked storage - external_id is left out */
	}
	if (pixelId && typeof window.fbq === "function" && (em || ph || eid)) {
		var matchData = {};
		if (em) matchData.em = em;
		if (ph) matchData.ph = ph;
		if (eid) matchData.external_id = eid;
		window.fbq("init", pixelId, matchData);
	}

	/*
		Lead: somebody completed the registration form. The standard event to
		optimise ad delivery against — the first point at which a click became
		a real registration on the sheet.

		Reported here, not at the moment of submit, because the redirect to
		this page would cancel a fbq() call made a moment earlier before it
		could send.
	*/
	if (!sessionStorage.getItem("markaz:pixel:lead")) {
		sessionStorage.setItem("markaz:pixel:lead", "1");
		if (typeof window.fbq === "function") {
			window.fbq("track", "Lead", { content_name: "Webinar registration" });
		}
	}

	/*
		Qualified_Lead: a custom event for the narrower group SignupForm.astro
		marked as qualified — now from BOTH the interest/enroll answers (see
		qualified-lead.ts) AND a basic bot/junk check made at submit time (an
		obviously fake-looking phone number, or a suspiciously instant
		submission — see the comment in SignupForm.astro). A lead that fails
		either part still registers normally; it just is not reported to Meta
		as a GOOD lead, so the algorithm is never taught that bot traffic or
		junk answers are what a qualified lead looks like.

		Read once from sessionStorage and removed, since it was only ever
		meant for the one page load right after submitting.
	*/
	var qualified = sessionStorage.getItem("markaz:lead-qualified") === "1";
	sessionStorage.removeItem("markaz:lead-qualified");
	if (qualified && !sessionStorage.getItem("markaz:pixel:qualified-lead")) {
		sessionStorage.setItem("markaz:pixel:qualified-lead", "1");
		if (typeof window.fbq === "function") {
			window.fbq("trackCustom", "Qualified_Lead", { content_name: "Webinar registration" });
		}
	}
} catch (err) {
	// Private mode, storage refused, or no pixel on this build. The page
	// itself has nothing left to do after this, so there is nothing to protect.
}
`;
---

<OutcomePage
	title={`Check your email — ${site.name}`}
	description="Your place is reserved. Confirm it from the email we just sent you."
>
	<h1 class="outcome__title">Almost there! Check your email</h1>

	<p class="outcome__lead">
		We sent you a confirmation email. Click the button inside to secure your spot.
	</p>

	<p class="outcome__tip">Can't find it? Check your Spam or Promotions folder.</p>
</OutcomePage>

<script is:inline set:html={checkEmailPixelJs} />

<style>
	.outcome__title {
		font-size: var(--text-2xl);
		text-transform: uppercase;
	}

	.outcome__lead {
		font-size: var(--text-lg);
		max-width: 36ch;
	}

	/* The quiet line. Tinted rather than just grey, so it reads as a hint and
	   not as another instruction. */
	.outcome__tip {
		padding: var(--space-xs) var(--space-md);
		border-radius: var(--radius-md);
		background: var(--color-brand-subtle);
		color: var(--color-text);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}

</style>
