---
import OutcomePage from "../layouts/OutcomePage.astro";
import { site } from "../data/config";

/**
 * Where the signup form sends people the moment their registration is saved.
 *
 * It asks nothing and calls nothing — no form, no API. Its whole job is to say
 * the confirmation email is on its way, and to head off the most common reason
 * people think it never arrived.
 */
---

<OutcomePage
	title={`Check your email — ${site.name}`}
	description="Your place is reserved. Confirm it from the email we just sent you."
>
	<h1 class="outcome__title">Almost there! Check your email</h1>

	<p class="outcome__lead">
		We sent you a confirmation email. Click the button inside to secure your spot.
	</p>

	<p class="outcome__tip">Can't find it? Check your Spam or Promotions folder.</p>
</OutcomePage>

<script is:inline>
	/*
		Meta Pixel calls made directly here, is:inline, with no import from a
		shared module — the same pattern droparabia-landing uses everywhere.

		A shared "pixel.ts" helper, imported from several pages, becomes its OWN
		built file, and Astro named it literally pixel.<hash>.js. A request path
		containing "pixel" is one of the most common ad-blocker filter targets
		there is, by name alone, regardless of the domain serving it — and
		proven here: deliberately blocking that one request made this page's
		entire script fail to run, nothing just about tracking. is:inline has no
		separate request to block in the first place.
	*/
	try {
		/*
			Lead: somebody completed the registration form. The standard event to
			optimise ad delivery against — the first point at which a click became
			a real registration on the sheet.

			Reported here, not at the moment of submit, because the redirect to
			this page would cancel a fbq() call made a moment earlier before it
			could send.
		*/
		if (!sessionStorage.getItem("markaz:pixel:lead")) {
			sessionStorage.setItem("markaz:pixel:lead", "1");
			if (typeof window.fbq === "function") {
				window.fbq("track", "Lead", { content_name: "Webinar registration" });
			}
		}

		/*
			Qualified_Lead: a custom event for the narrower group SignupForm.astro
			marked as qualified from their interest/enroll answers (see
			qualified-lead.ts). Read once from sessionStorage and removed, since it
			was only ever meant for the one page load right after submitting.
		*/
		var qualified = sessionStorage.getItem("markaz:lead-qualified") === "1";
		sessionStorage.removeItem("markaz:lead-qualified");
		if (qualified && !sessionStorage.getItem("markaz:pixel:qualified-lead")) {
			sessionStorage.setItem("markaz:pixel:qualified-lead", "1");
			if (typeof window.fbq === "function") {
				window.fbq("trackCustom", "Qualified_Lead", { content_name: "Webinar registration" });
			}
		}
	} catch (err) {
		// Private mode, storage refused, or no pixel on this build. The page
		// itself has nothing left to do after this, so there is nothing to protect.
	}
</script>

<style>
	.outcome__title {
		font-size: var(--text-2xl);
		text-transform: uppercase;
	}

	.outcome__lead {
		font-size: var(--text-lg);
		max-width: 36ch;
	}

	/* The quiet line. Tinted rather than just grey, so it reads as a hint and
	   not as another instruction. */
	.outcome__tip {
		padding: var(--space-xs) var(--space-md);
		border-radius: var(--radius-md);
		background: var(--color-brand-subtle);
		color: var(--color-text);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}

</style>
