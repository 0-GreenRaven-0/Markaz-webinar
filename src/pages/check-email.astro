---
import OutcomePage from "../layouts/OutcomePage.astro";
import { site } from "../data/config";

/**
 * Where the signup form sends people the moment their registration is saved.
 *
 * It asks nothing and calls nothing — no form, no API. Its whole job is to say
 * the confirmation email is on its way, and to head off the most common reason
 * people think it never arrived.
 */
---

<OutcomePage
	title={`Check your email — ${site.name}`}
	description="Your place is reserved. Confirm it from the email we just sent you."
>
	<h1 class="outcome__title">Almost there! Check your email</h1>

	<p class="outcome__lead">
		We sent you a confirmation email. Click the button inside to secure your spot.
	</p>

	<p class="outcome__tip">Can't find it? Check your Spam or Promotions folder.</p>

	<a class="outcome__back" href="/">&larr; Back to the webinar</a>
</OutcomePage>

<script>
	import { track, trackCustom, once } from "../lib/pixel";

	/*
		Lead: somebody completed the registration form. This is the standard
		event to optimise ad delivery against — it is the first point at which a
		click has become a real registration on the sheet.

		Reported here rather than at the moment of submit, because the redirect
		to this page would cancel a fbq() call made a moment earlier before it
		could send.
	*/
	once("lead", () => track("Lead", { content_name: "Webinar registration" }));

	/*
		Qualified_Lead: a custom event for the narrower group SignupForm.astro
		marked as qualified from their interest/enroll answers (see
		qualified-lead.ts). Read once from sessionStorage and removed, since it
		was only ever meant for the one page load right after submitting.
	*/
	try {
		const qualified = sessionStorage.getItem("markaz:lead-qualified") === "1";
		sessionStorage.removeItem("markaz:lead-qualified");
		if (qualified) {
			once("qualified-lead", () =>
				trackCustom("Qualified_Lead", { content_name: "Webinar registration" }),
			);
		}
	} catch {
		// Private mode, or storage refused. Lead above still fired.
	}
</script>

<style>
	.outcome__title {
		font-size: var(--text-2xl);
		text-transform: uppercase;
	}

	.outcome__lead {
		font-size: var(--text-lg);
		max-width: 36ch;
	}

	/* The quiet line. Tinted rather than just grey, so it reads as a hint and
	   not as another instruction. */
	.outcome__tip {
		padding: var(--space-xs) var(--space-md);
		border-radius: var(--radius-md);
		background: var(--color-brand-subtle);
		color: var(--color-text);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}

	.outcome__back {
		margin-block-start: var(--space-sm);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-brand-strong);
	}
</style>
