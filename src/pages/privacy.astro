---
import LegalPage from "../layouts/LegalPage.astro";
import { site } from "../data/config";

/**
 * Ported from the droparabia-landing policy and rewritten to describe what THIS
 * site actually does.
 *
 * The Meta Pixel, Google Analytics, Google Tag Manager and Google Ads
 * sections ARE here because all four are installed (see metaPixelId,
 * gaMeasurementId, gtmContainerId and googleAdsId in config.ts). Calendly is
 * still left out, because the site does not run it — a policy that claims
 * tracking the site does not do is worse for the visitor than saying nothing.
 *
 * If any of these is ever removed, update section 3 and its line in section
 * 4 to match — this file does not update itself when config.ts changes.
 */
---

<LegalPage
	title={`Privacy policy — ${site.name}`}
	description={`How ${site.name} collects, uses and protects the information you give us when you register for the free webinar.`}
	heading="Privacy policy"
	updated="October 2026"
>
	<p>
		{site.name} is committed to protecting your personal information. This policy explains
		what we collect, how we use it, and how we keep it safe when you visit this site or
		register for our free webinar.
	</p>

	<section>
		<h2>1. Information we collect</h2>
		<ul>
			<li><strong>Details you give us:</strong> your full name, email address and phone number, including the country code you select.</li>
			<li><strong>When you registered:</strong> the date and time your registration reached us.</li>
			<li><strong>Your attendance status:</strong> whether your place is unconfirmed or confirmed.</li>
		</ul>
		<p>
			We do not ask for and do not store payment details, identity documents or any
			information beyond the fields on the registration form.
		</p>
	</section>

	<section>
		<h2>2. How we use your information</h2>
		<ul>
			<li>To reserve your seat and send you the link to the webinar</li>
			<li>To remind you before it starts, and to follow up afterwards</li>
			<li>To tell you about our programs and offers</li>
			<li>To improve our content and the webinar itself</li>
			<li>For legal compliance and security</li>
		</ul>
	</section>

	<section>
		<h2>3. Cookies and tracking</h2>
		<p>
			This site runs the <strong>Meta Pixel</strong> and Google's advertising and analytics
			tools (<strong>Google Analytics</strong>, <strong>Google Tag Manager</strong> and
			<strong>Google Ads</strong>), so that we can measure how our advertising performs and
			show relevant ads on Facebook, Instagram and Google. They set cookies and may collect
			information such as your IP address, browser details, the pages you visit and what you
			do on them.
		</p>
		<p>
			You can control ad personalisation in your Facebook and Instagram ad settings and your
			Google ad settings, and block cookies through your browser settings.
		</p>
		<p>
			Separately from that, your browser keeps a short note of which version of the headline
			you were shown, so the page does not change under you while you read it. It is kept by
			your browser alone, is cleared when you close the tab, and tells us nothing about you.
		</p>
	</section>

	<section>
		<h2>4. Data sharing</h2>
		<p>
			We do not sell or rent your personal data. We share it only with the services we need
			to run the webinar:
		</p>
		<ul>
			<li><strong>Google Sheets</strong> — where your registration is recorded</li>
			<li><strong>Brevo</strong> — the service that sends you the webinar link and reminders</li>
			<li><strong>Cloudflare</strong> — hosts this site and passes your form submission to the above</li>
			<li><strong>Meta Platforms</strong> — advertising measurement and optimisation</li>
			<li><strong>Google</strong> — Analytics, Tag Manager and Ads, for advertising measurement and optimisation</li>
		</ul>
	</section>

	<section>
		<h2>5. Data security</h2>
		<p>
			Your details are sent over an encrypted connection and held in access-controlled
			accounts. No system is one hundred per cent secure, but we take reasonable steps to
			safeguard your information.
		</p>
	</section>

	<section>
		<h2>6. Data retention</h2>
		<p>
			We keep your information for as long as we need it to run the webinar and follow up
			with you, or until you ask us to delete it.
		</p>
	</section>

	<section>
		<h2>7. Your rights</h2>
		<p>
			You can ask us to access, correct or delete your personal data at any time, or ask us
			to stop sending you messages. Every email we send also has an unsubscribe link.
			Contact us at <a href={`mailto:${site.email}`}>{site.email}</a>.
		</p>
	</section>

	<section>
		<h2>8. Policy updates</h2>
		<p>
			We may update this policy from time to time. The most recent version is always on this
			page, with the date it was last updated.
		</p>
	</section>

	<section>
		<h2>Contact</h2>
		<p>
			Any questions about this policy: <a href={`mailto:${site.email}`}>{site.email}</a>.
		</p>
	</section>
</LegalPage>
