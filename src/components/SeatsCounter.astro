---
import { seatsRemaining } from "../data/config";

/**
 * The seat counter.
 *
 * It deliberately shows nothing but a loading animation at first. The real
 * figure is the number in config.ts minus everyone already on the signup
 * sheet, which only /api/seats can work out — this page is static, so the
 * number cannot be in the HTML.
 *
 * `data-seats-fallback` is the configured number, used only if that request
 * fails. A slightly stale count is harmless; an empty hero is not.
 *
 * After the first load it keeps asking, every POLL_MS, for as long as the
 * page is open and the tab is in front — so a row deleted from the sheet
 * while someone is sitting on the page hands their spot back without them
 * having to reload. /api/seats recomputes the figure from the sheet's current
 * row count on every call; nothing here assumes the number only goes down.
 */
---

<p class="seats" data-seats-fallback={seatsRemaining} data-state="loading" aria-busy="true">
	<span class="seats__slot">
		<span class="seats__number" data-seats-number></span>
		<span class="seats__loader" aria-hidden="true">
			<span class="seats__dot"></span>
			<span class="seats__dot"></span>
			<span class="seats__dot"></span>
		</span>
		<span class="visually-hidden" data-seats-status>Checking how many seats are left</span>
	</span>
	<span class="seats__label">seats remaining</span>
</p>

<script>
	const EASE_MS = 1400;
	/* The loader is held briefly even on a fast answer. A counter that flashes
	   through three states in 80ms reads as a glitch rather than as loading. */
	const MIN_LOADER_MS = 600;
	/* How often the page asks again once it has an answer. Matches the 30s
	   edge cache on /api/seats, so a poll either gets a fresh number or costs
	   nothing — there is no point asking faster than the number can change. */
	const POLL_MS = 30_000;

	for (const el of document.querySelectorAll<HTMLElement>(".seats")) {
		const numberEl = el.querySelector<HTMLElement>("[data-seats-number]");
		const statusEl = el.querySelector<HTMLElement>("[data-seats-status]");
		const fallback = Number(el.dataset.seatsFallback ?? "0");
		if (!numberEl) continue;

		const startedAt = performance.now();
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		/* What the box currently shows, so a later update animates from there
		   rather than from zero. Zero only ever describes the very first paint. */
		let shown = 0;
		let frame = 0;

		const animateTo = (target: number) => {
			cancelAnimationFrame(frame);

			// Pin the box to the width of the new number so it cannot shove the
			// label sideways as the digit count changes.
			el.style.setProperty("--seats-digits", String(String(target).length));
			if (statusEl) statusEl.textContent = `${target} seats remaining`;

			if (reduceMotion) {
				numberEl.textContent = String(target);
				shown = target;
				return;
			}

			const from = shown;
			const delta = target - from;
			const start = performance.now();
			const tick = (now: number) => {
				const t = Math.min((now - start) / EASE_MS, 1);
				// easeOutCubic — fast at first, settling at the end
				const eased = 1 - Math.pow(1 - t, 3);
				const value = Math.round(from + delta * eased);
				numberEl.textContent = String(value);
				shown = value;
				if (t < 1) {
					frame = requestAnimationFrame(tick);
				} else {
					numberEl.textContent = String(target);
					shown = target;
				}
			};
			frame = requestAnimationFrame(tick);
		};

		/* The loading dots are only ever shown for the very first answer. Every
		   later poll updates the number in place, with no loading state —
		   showing dots every 30 seconds would read as the page stalling. */
		const revealFirst = (target: number) => {
			el.dataset.state = "ready";
			el.setAttribute("aria-busy", "false");
			animateTo(target);
		};

		const ask = (): Promise<number | null> =>
			fetch("/api/seats", { headers: { accept: "application/json" } })
				.then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
				.then((data: { remaining?: number }) => {
					const remaining = Number(data?.remaining);
					return Number.isFinite(remaining) && remaining >= 0 ? remaining : null;
				})
				.catch(() => null);

		let timer = 0;

		const poll = () => {
			ask().then((remaining) => {
				// A later request landing after an even later one has already
				// shown its answer would overwrite it with a stale number. The
				// tab being backgrounded, or the page having unloaded, is also
				// reason enough to drop a result rather than apply it.
				if (remaining !== null && !document.hidden) animateTo(remaining);
			});
		};

		const schedule = () => {
			window.clearInterval(timer);
			timer = window.setInterval(poll, POLL_MS);
		};

		// Coming back to the tab asks right away rather than waiting out
		// whatever was left of the interval — the number may be well out of
		// date by the time someone returns to it.
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) {
				window.clearInterval(timer);
			} else {
				poll();
				schedule();
			}
		});

		ask().then((remaining) => {
			const elapsed = performance.now() - startedAt;
			const wait = Math.max(0, MIN_LOADER_MS - elapsed);
			window.setTimeout(() => {
				revealFirst(remaining ?? fallback);
				schedule();
			}, wait);
		});
	}
</script>

<style>
	.seats {
		display: flex;
		align-items: baseline;
		gap: var(--space-2xs);
		margin: 0;
	}

	/* Holds the number and the loader in the same place, so the row does not
	   jump when one replaces the other. */
	.seats__slot {
		display: inline-grid;
		place-items: center end;
	}

	.seats__slot > * {
		grid-area: 1 / 1;
	}

	.seats__number {
		font-family: var(--font-display);
		font-weight: var(--weight-display);
		font-size: var(--text-3xl);
		line-height: var(--leading-tight);
		color: var(--color-text);
		/* Marzano digits are proportional and it has no tnum feature, so the box
		   is pinned to the width of the widest digits instead. Sized from the
		   final figure, so counting up never moves the label. */
		font-variant-numeric: tabular-nums;
		min-width: calc(var(--seats-digits, 3) * 0.66em);
		text-align: end;
		opacity: 0;
		transition: opacity 240ms ease;
	}

	.seats[data-state="ready"] .seats__number {
		opacity: 1;
	}

	/* --- Loading --- */
	.seats__loader {
		display: flex;
		align-items: center;
		gap: var(--space-3xs);
		/* Matches the height the number will occupy, so nothing shifts. */
		height: 1em;
		font-size: var(--text-3xl);
		opacity: 1;
		transition: opacity 180ms ease;
	}

	.seats[data-state="ready"] .seats__loader {
		opacity: 0;
		pointer-events: none;
	}

	/* Hard-edged squares rather than circles — the same low-poly language as
	   the button and the panels. */
	.seats__dot {
		width: 0.22em;
		height: 0.22em;
		background: var(--color-brand);
		animation: seats-pulse 1100ms ease-in-out infinite;
	}

	.seats__dot:nth-child(2) {
		animation-delay: 160ms;
	}

	.seats__dot:nth-child(3) {
		animation-delay: 320ms;
	}

	@keyframes seats-pulse {
		0%,
		100% {
			opacity: 0.25;
			transform: scale(0.8);
		}
		50% {
			opacity: 1;
			transform: scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.seats__dot {
			animation: none;
			opacity: 0.6;
		}
	}

	.seats__label {
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		/* The brightest green in the palette, as asked. Worth knowing: it sits at
		   2.6:1 on white, well under the 4.5:1 readability threshold.
		   --color-brand-strong is the same hue and passes, if you want to swap. */
		color: var(--color-brand);
	}
</style>
