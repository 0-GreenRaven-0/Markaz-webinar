---
import CountrySelect from "./CountrySelect.astro";
import SelectField from "./SelectField.astro";
import { signupQuestions } from "../data/config";

/**
 * The submit button is filled with a low-poly facet pattern, built from a
 * jittered grid so the triangles tile it completely with no gaps.
 *
 * The greens are sampled directly out of the brand flag artwork, so they are
 * the exact tones in that image rather than an approximation.
 *
 * The label is white, which is what the flag artwork does. Most of these
 * greens are too light to carry white text on their own, so the facets behind
 * the label are drawn from the darker end of the set and the lighter tones are
 * pushed to the top and bottom bands. That also mimics how a real flag shades
 * through its folds.
 *
 * Points on the outer boundary are bitten inward at random, so the silhouette
 * is ragged like a torn flag rather than a clean rectangle.
 */
const BTN_W = 320;
const BTN_H = 64;
const COLS = 11;
const ROWS = 3;
/**
 * How far boundary points may bite into the rectangle. RAG_Y used to be 7 —
 * on a button only 64px tall, that let two neighbouring points on the top or
 * bottom edge swing independently by up to 7px each, with no relation to one
 * another, which is what drew the sharp zigzag rather than a soft wave.
 * Keeping it below a third of that still leaves the top and bottom
 * noticeably uneven, just without the spikes.
 */
const RAG_X = 9;
const RAG_Y = 2;

/** Lighter flag tones — used in the top and bottom bands. */
const LIGHT_FACETS = ["g1", "g2", "g2", "g3", "g3", "g4"] as const;
/** Deeper flag tones — used in the middle band, behind the label. */
const DARK_FACETS = ["g4", "g5", "g5", "g6", "g6", "g7"] as const;

function mulberry32(a: number) {
	return function () {
		a |= 0;
		a = (a + 0x6d2b79f5) | 0;
		let t = Math.imul(a ^ (a >>> 15), 1 | a);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const rand = mulberry32(424242);
const r1 = (n: number) => Math.round(n * 10) / 10;

const cellW = BTN_W / COLS;
const cellH = BTN_H / ROWS;
const grid: [number, number][][] = [];

for (let r = 0; r <= ROWS; r++) {
	grid[r] = [];
	for (let c = 0; c <= COLS; c++) {
		const onLeft = c === 0;
		const onRight = c === COLS;
		const onTop = r === 0;
		const onBottom = r === ROWS;

		let x = (c / COLS) * BTN_W;
		let y = (r / ROWS) * BTN_H;

		if (!onLeft && !onRight) x += (rand() - 0.5) * cellW * 0.8;
		if (!onTop && !onBottom) y += (rand() - 0.5) * cellH * 0.8;

		// Bite the silhouette inward only, so it can never overflow its box.
		if (onLeft) x += rand() * RAG_X;
		if (onRight) x -= rand() * RAG_X;
		if (onTop) y += rand() * RAG_Y;
		if (onBottom) y -= rand() * RAG_Y;

		if ((onTop || onBottom) && !onLeft && !onRight) x += (rand() - 0.5) * cellW * 0.6;
		if ((onLeft || onRight) && !onTop && !onBottom) y += (rand() - 0.5) * cellH * 0.6;

		grid[r][c] = [x, y];
	}
}

const triangles: { points: string; tone: string }[] = [];
for (let r = 0; r < ROWS; r++) {
	for (let c = 0; c < COLS; c++) {
		const a = grid[r][c];
		const b = grid[r][c + 1];
		const d = grid[r + 1][c + 1];
		const e = grid[r + 1][c];
		const pair =
			rand() > 0.5
				? [
						[a, b, d],
						[a, d, e],
					]
				: [
						[a, b, e],
						[b, d, e],
					];
		// The middle band sits behind the label, so it draws from the deeper tones.
		const palette = r === Math.floor(ROWS / 2) ? DARK_FACETS : LIGHT_FACETS;
		for (const tri of pair) {
			triangles.push({
				points: tri.map((p) => `${r1(p[0])},${r1(p[1])}`).join(" "),
				tone: palette[Math.floor(rand() * palette.length)],
			});
		}
	}
}
---

<form class="form" novalidate>
	<div class="field">
		<label class="field__label" for="full-name">Full name</label>
		<div class="field__box">
			<input
				class="field__input"
				id="full-name"
				name="full_name"
				type="text"
				placeholder="Your first and last name"
				autocomplete="name"
				required
				aria-describedby="name-error"
			/>
		</div>
		<p class="field__error" id="name-error" data-error-for="full_name"></p>
	</div>

	<div class="field">
		<label class="field__label" for="email">Email</label>
		<div class="field__box">
			<input
				class="field__input"
				id="email"
				name="email"
				type="email"
				inputmode="email"
				autocomplete="email"
				required
				aria-describedby="email-error"
			/>
		</div>
		<p class="field__error" id="email-error" data-error-for="email"></p>
		{/*
			Offered when the domain looks like a near miss for a common provider —
			"gmial.com", "hotmai.com". Nothing is ever rewritten automatically: the
			visitor taps the suggestion or ignores it. A mistyped address is the
			most common way a real person never receives the webinar link.
		*/}
		<p class="field__suggest" data-suggest hidden>
			Did you mean <button class="field__suggest-btn" type="button" data-suggest-btn></button>?
		</p>
	</div>

	<div class="field">
		<label class="field__label" for="phone">Phone number</label>
		<div class="phone">
			<CountrySelect />
			<div class="field__box">
				<input
					class="field__input"
					id="phone"
					name="phone"
					type="tel"
					inputmode="tel"
					autocomplete="tel-national"
					placeholder="70 123 456"
					required
					aria-describedby="phone-error"
				/>
			</div>
		</div>
		<p class="field__error" id="phone-error" data-error-for="phone"></p>
	</div>

	<div class="form__disclaimer">
		<p class="form__disclaimer-text">
			Your answers won't affect your ability to attend the free webinar.
		</p>
	</div>

	{/*
		The qualifying questions, built from signupQuestions in config.ts.
		They use SelectField rather than a native <select>, because the open list
		of a native one is drawn by the operating system and ignores the site's
		fonts, colours and angled edges completely.
	*/}
	{
		signupQuestions.map((question) => (
			<div
				class="field"
				data-question={question.id}
				hidden={Boolean(question.revealedBy)}
				data-reveal-when={question.revealedBy ? JSON.stringify(question.revealedBy) : undefined}
			>
				<label class="field__label" for={question.id}>
					{question.label}
				</label>
				<SelectField id={question.id} options={question.options} />
				<p class="field__error" id={`${question.id}-error`} data-error-for={question.id} />
			</div>
		))
	}

	{/* Hidden from people, visible to bots. The server drops anything that fills it. */}
	<div class="form__trap" aria-hidden="true">
		<label for="company">Company</label>
		<input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
	</div>

	<button class="form__submit" type="submit">
		<svg
			class="form__submit-poly"
			viewBox={`0 0 ${BTN_W} ${BTN_H}`}
			preserveAspectRatio="none"
			aria-hidden="true"
			focusable="false"
		>
			{triangles.map((t) => <polygon class={`gfacet gfacet--${t.tone}`} points={t.points} />)}
		</svg>
		<span class="form__submit-label" data-submit-label>Claim my seat</span>
	</button>

	<p class="form__warning">Replays aren't guaranteed so be sure to attend</p>

	<p class="form__status" role="status" aria-live="polite" data-status></p>
</form>



<script>
	import { signupQuestions } from "../data/config";
	import { isQualifiedLead } from "../lib/qualified-lead";

	/*
		Meta Pixel calls are made directly against window.fbq here — never
		through a shared helper module. A shared module importED BY SEVERAL
		pages becomes its own chunk, and when that chunk is named anything
		resembling "pixel" it is a textbook target for ad-blocker filename
		filters. Confirmed by testing it: blocking a request matching
		/pixel\.[a-z0-9]+\.js/ made this ENTIRE script fail to run at all —
		not just the tracking call, the real submit handler below with it,
		because a static import that fails to load aborts the whole module
		before any of its own code executes. Each fbq() call below is wrapped in
		its own try/catch so a blocked or missing pixel can never take the form
		down with it.
	*/
	const fireOnce = (key: string, fire: () => void) => {
		const slot = `markaz:pixel:${key}`;
		try {
			if (sessionStorage.getItem(slot)) return;
			sessionStorage.setItem(slot, "1");
		} catch {
			// Private mode, or storage refused — fire anyway; a double count on
			// a reload is the lesser problem.
		}
		fire();
	};

	const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

	/*
		Decides whether a signup's Qualified_Lead pixel event should actually
		fire — never whether the signup itself is accepted. The registration
		always saves exactly as before; this only stops an obviously fake or
		bot-like submission from being reported to Meta as a GOOD lead, which
		is what teaches the ad algorithm to go find more of the same junk.

		The email side of this is already covered more thoroughly than
		anything client-side could check: every submission already passes
		through checkEmail() on the server (src/lib/email-check.ts) — real
		syntax, not a known disposable provider, and a live DNS lookup
		confirming the domain can receive mail — before the row is even
		written. A submission that reaches this point already cleared a
		stricter bar than a plain regex, so there is nothing to repeat here.

		Not implemented: blocking common personal providers (gmail, yahoo,
		hotmail). That is a B2B heuristic — it assumes a "good" lead uses a
		work email. This is a free consumer webinar for individuals in
		Lebanon; gmail is what a real, serious lead looks like here, not a
		red flag. Applying it would have disqualified the majority of
		genuinely good signups.
	*/
	const MIN_TIME_ON_PAGE_MS = 8_000;
	const MIN_FORM_FILL_MS = 3_000;

	/** "0000000000", "1111111111" — every digit the same. */
	const isRepeatedDigit = (digits: string) => /^(\d)\1+$/.test(digits);

	/** "123456...", "987654..." — a simple run up or down the keypad. */
	const isSequentialDigits = (digits: string) => {
		if (digits.length < 4) return false;
		let ascending = true;
		let descending = true;
		for (let i = 1; i < digits.length; i++) {
			const diff = digits.charCodeAt(i) - digits.charCodeAt(i - 1);
			if (diff !== 1) ascending = false;
			if (diff !== -1) descending = false;
		}
		return ascending || descending;
	};

	/* 10 digits is a stricter floor than the field's own 6-15 validation (that
	   range stays permissive on purpose, for the real short-number formats a
	   genuine visitor might have) — this is only about whether the number
	   looks real enough to call the lead qualified, not whether to accept it. */
	const looksLikeJunkPhone = (digits: string) =>
		digits.length < 10 || isRepeatedDigit(digits) || isSequentialDigits(digits);

	/** Lowercase hex SHA-256, what Meta's Advanced Matching expects for em/ph. */
	const sha256Hex = async (input: string): Promise<string> => {
		const bytes = new TextEncoder().encode(input);
		const digest = await crypto.subtle.digest("SHA-256", bytes);
		return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
	};

	/* The dropdowns are built from the same list as the markup, so adding a
	   question in config.ts makes it required and submitted without touching
	   anything here. */
	const QUESTION_IDS = signupQuestions.map((question) => question.id);

	/* The providers our visitors actually use. */
	const KNOWN_DOMAINS = [
		"gmail.com", "yahoo.com", "hotmail.com", "outlook.com", "icloud.com",
		"live.com", "hotmail.co.uk", "outlook.fr", "windowslive.com",
	];

	/* Levenshtein, capped: past 2 edits it is a different domain, not a typo. */
	const distance = (a: string, b: string): number => {
		if (Math.abs(a.length - b.length) > 2) return 99;
		let prev = Array.from({ length: b.length + 1 }, (_, j) => j);
		for (let i = 1; i <= a.length; i++) {
			const curr = [i];
			for (let k = 1; k <= b.length; k++) {
				curr[k] = Math.min(
					prev[k] + 1,
					curr[k - 1] + 1,
					prev[k - 1] + (a[i - 1] === b[k - 1] ? 0 : 1),
				);
			}
			prev = curr;
		}
		return prev[b.length];
	};

	/**
	 * The whole corrected address, or null when the domain is already one we
	 * know, is too far from any of them, or is not an address yet.
	 */
	const suggestEmail = (value: string): string | null => {
		const email = (value || "").trim().toLowerCase();
		const at = email.lastIndexOf("@");
		if (at < 1 || at === email.length - 1) return null;
		const local = email.slice(0, at);
		const domain = email.slice(at + 1);
		// A domain of four characters or fewer is within two edits of far too much.
		if (!domain.includes(".") || domain.length < 5) return null;
		if (KNOWN_DOMAINS.includes(domain)) return null;

		let best: string | null = null;
		let bestDistance = 3;
		for (const candidate of KNOWN_DOMAINS) {
			const d = distance(domain, candidate);
			if (d < bestDistance) {
				bestDistance = d;
				best = candidate;
			}
		}
		return best ? `${local}@${best}` : null;
	};

	for (const form of document.querySelectorAll<HTMLFormElement>(".form")) {
		const statusEl = form.querySelector<HTMLElement>("[data-status]");
		const submitEl = form.querySelector<HTMLButtonElement>(".form__submit");
		// The label is its own element: writing to the button's textContent would
		// wipe out the SVG facets behind it.
		const labelEl = form.querySelector<HTMLElement>("[data-submit-label]");
		const combo = form.querySelector<HTMLElement>("[data-combo]");

		// Set the moment the FormStart pixel event fires, below — the gap
		// between this and submit is the bot-check's "form fill time".
		let formStartedAt: number | null = null;

		const setError = (name: string, message: string) => {
			const field = form.querySelector<HTMLElement>(`[name="${name}"]`);
			const errorEl = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
			if (errorEl) errorEl.textContent = message;
			const wrapper = field?.closest(".field");
			// A custom dropdown's value lives in a hidden input, which announces
			// nothing — mark the button the visitor actually focuses instead.
			const target = wrapper?.querySelector<HTMLElement>("[data-select-trigger]") ?? field;
			target?.setAttribute("aria-invalid", message ? "true" : "false");
			wrapper?.toggleAttribute("data-invalid", Boolean(message));
		};

		/** "Ada  Lovelace King" -> first "Ada", last "Lovelace King". */
		const splitName = (full: string) => {
			const parts = full.trim().split(/\s+/);
			return { first: parts[0] ?? "", last: parts.slice(1).join(" ") };
		};

		const validate = () => {
			const data = new FormData(form);
			const full = String(data.get("full_name") ?? "").trim();
			const email = String(data.get("email") ?? "").trim();
			const phone = String(data.get("phone") ?? "").trim();
			const errors: Record<string, string> = {};

			const { first, last } = splitName(full);
			if (first.length < 2 || last.length < 1) {
				errors.full_name = "Please enter your first and last name.";
			}
			if (!EMAIL_RE.test(email)) errors.email = "Please enter a valid email address.";

			const digits = phone.replace(/\D/g, "");
			if (digits.length < 6 || digits.length > 15) {
				errors.phone = "Please enter a valid phone number.";
			}

			for (const id of QUESTION_IDS) {
				// A question nobody has been shown cannot be required.
				if (form.querySelector<HTMLElement>(`[data-question="${id}"]`)?.hidden) continue;
				if (!String(data.get(id) ?? "").trim()) {
					errors[id] = "Please choose the one that fits you.";
				}
			}

			for (const name of ["full_name", "email", "phone", ...QUESTION_IDS]) {
				setError(name, errors[name] ?? "");
			}
			return { errors, data };
		};

		/*
			Questions that only appear once an earlier one is answered a certain
			way. Which question and which answers come from config.ts, so the rule
			is editable without touching this code.

			A question that is hidden again has its answer cleared, so an answer
			nobody can see is never submitted.
		*/
		const conditionals = [...form.querySelectorAll<HTMLElement>("[data-reveal-when]")].map(
			(field) => ({
				field,
				rule: JSON.parse(field.dataset.revealWhen ?? "{}") as {
					question: string;
					answers: string[];
				},
			}),
		);

		const syncConditionals = () => {
			for (const { field, rule } of conditionals) {
				const answer = String(
					form.querySelector<HTMLInputElement>(`[name="${rule.question}"]`)?.value ?? "",
				);
				const show = rule.answers.includes(answer);
				if (show === !field.hidden) continue;

				field.hidden = !show;
				if (show) {
					field.setAttribute("data-revealed", "");
				} else {
					field.removeAttribute("data-revealed");
					field.removeAttribute("data-invalid");
					const errorEl = field.querySelector<HTMLElement>("[data-error-for]");
					if (errorEl) errorEl.textContent = "";
					field.querySelector("[data-select]")?.dispatchEvent(new CustomEvent("select:reset"));
				}
			}
		};

		form.addEventListener("input", syncConditionals);
		syncConditionals();

		// The "did you mean" line under the email field.
		const emailEl = form.querySelector<HTMLInputElement>('[name="email"]');
		const suggestEl = form.querySelector<HTMLElement>("[data-suggest]");
		const suggestBtn = form.querySelector<HTMLButtonElement>("[data-suggest-btn]");

		const hideSuggestion = () => suggestEl?.setAttribute("hidden", "");

		if (emailEl && suggestEl && suggestBtn) {
			// On leaving the field, not while typing: every half-finished address
			// looks like a typo.
			emailEl.addEventListener("blur", () => {
				const guess = suggestEmail(emailEl.value);
				if (guess) {
					suggestBtn.textContent = guess;
					suggestEl.removeAttribute("hidden");
				} else {
					hideSuggestion();
				}
			});
			emailEl.addEventListener("input", hideSuggestion);
			suggestBtn.addEventListener("click", () => {
				emailEl.value = suggestBtn.textContent ?? emailEl.value;
				hideSuggestion();
				setError("email", "");
				emailEl.focus();
			});
		}

		// Clear a field's error as soon as the visitor fixes it.
		form.addEventListener("input", (e) => {
			const target = e.target as HTMLInputElement;
			if (target.name && target.closest(".field")?.hasAttribute("data-invalid")) {
				validate();
			}
		});

		/*
			FormStart: the first time anyone types in or opens anything on the
			form. Custom rather than standard, because Meta has no standard event
			for it — its value is the gap between this and Lead, which tells you
			how many people start registering and give up.

			The dropdowns write to a hidden field and dispatch the same "input"
			event, so choosing an answer counts as starting too.
		*/
		form.addEventListener(
			"input",
			() => {
				// Independent of fireOnce below — that only dedupes the pixel call
				// across a session, but the fill-time clock needs to start on THIS
				// page load even on a second visit in the same session.
				formStartedAt = Date.now();
				fireOnce("form-start", () => {
					try {
						(window as unknown as { fbq?: (...args: unknown[]) => void }).fbq?.(
							"trackCustom",
							"FormStart",
						);
					} catch {
						// An ad blocker, or no pixel on this build. Never block the form.
					}
				});
			},
			{ once: true },
		);

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const { errors, data } = validate();

			if (Object.keys(errors).length > 0) {
				form.querySelector<HTMLInputElement>('[aria-invalid="true"]')?.focus();
				if (statusEl) {
					statusEl.dataset.tone = "error";
					statusEl.textContent = "Please fix the highlighted fields.";
				}
				return;
			}

			const full = String(data.get("full_name") ?? "").trim();
			const { first, last } = splitName(full);
			const dial = combo?.dataset.dial ?? "";
			const phone = String(data.get("phone") ?? "").trim();

			// Set once per session by BaseLayout.astro on first landing — see the
			// comment on trafficSourceJs there. Empty if storage was blocked.
			// campaignName/adName stay empty unless that first landing looked like
			// paid traffic — see isPaid in the same script.
			let trafficSource = "";
			let campaignName = "";
			let adName = "";
			try {
				trafficSource = sessionStorage.getItem("markaz:traffic_source") ?? "";
				campaignName = sessionStorage.getItem("markaz:campaign_name") ?? "";
				adName = sessionStorage.getItem("markaz:ad_name") ?? "";
			} catch {
				// Private mode, or storage refused.
			}

			const payload = {
				// Split as well as whole, so either shape is usable downstream.
				full_name: full,
				first_name: first,
				last_name: last,
				email: String(data.get("email") ?? "").trim(),
				country: String(data.get("country") ?? ""),
				dial_code: dial,
				phone,
				phone_full: `${dial} ${phone}`.trim(),
				// One entry per qualifying dropdown, keyed by its id in config.ts.
				...Object.fromEntries(QUESTION_IDS.map((id) => [id, String(data.get(id) ?? "")])),
				// Which headline this visitor saw, so you can tell which one converts.
				hook_variant: document.documentElement.dataset.hook ?? "",
				traffic_source: trafficSource,
				campaign_name: campaignName,
				ad_name: adName,
				submitted_at: new Date().toISOString(),
			};

			if (submitEl) submitEl.disabled = true;
			if (labelEl) labelEl.textContent = "Sending…";

			const done = (tone: "success" | "error", message: string) => {
				if (statusEl) {
					statusEl.dataset.tone = tone;
					statusEl.textContent = message;
				}
				if (submitEl) submitEl.disabled = false;
				if (labelEl) labelEl.textContent = "Claim my seat";
			};

			/*
				A bound on how long the button is allowed to sit on "Sending…". The
				server itself now times out every external call it makes (Google,
				Brevo), but this is the backstop on THIS side of the connection: if
				the request is ever dropped somewhere between here and there with no
				response coming back at all, fetch() has no timeout of its own and
				would otherwise wait forever, leaving the button stuck with no
				error, no way out, and no way for the visitor to tell if it worked.
			*/
			const requestTimeout = new AbortController();
			const timeoutTimer = setTimeout(() => requestTimeout.abort(), 15_000);

			try {
				const res = await fetch("/api/subscribe", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(payload),
					signal: requestTimeout.signal,
				});
				clearTimeout(timeoutTimer);
				const result = (await res.json().catch(() => ({}))) as { error?: string };

				if (!res.ok) {
					const message = result.error || "Something went wrong. Please try again in a moment.";
					// 422 is the email check turning the address down. Put the reason on
					// the field itself so it is obvious which one to fix.
					if (res.status === 422) {
						setError("email", message);
						emailEl?.focus();
					}
					done("error", message);
					return;
				}

				/*
					Whether this signup is a Qualified_Lead, decided from BOTH the
					interest/enroll answers (see qualified-lead.ts) AND a basic
					bot/junk check on top — an obviously fake-looking phone number,
					or a suspiciously instant submission. Neither check touches
					whether the registration is accepted; a "junk-looking" signup
					still saves exactly as before. This only decides whether it gets
					reported to Meta as a GOOD lead, so the algorithm is never taught
					that bot traffic or junk answers are what a qualified lead looks
					like. See the long comment above MIN_TIME_ON_PAGE_MS for the full
					reasoning, including why email is not re-checked here.

					Handed to /check-email through sessionStorage rather than the
					URL, since a fbq("track", ...) call made right before navigation
					is often cancelled by the navigation itself before it can send —
					so the event is fired from the NEXT page instead, once it has
					loaded.
				*/
				const timeOnPageMs = Date.now() - performance.timeOrigin;
				const fillMs = formStartedAt === null ? 0 : Date.now() - formStartedAt;
				const phoneDigits = `${dial}${phone}`.replace(/\D/g, "");
				const looksBotlike =
					timeOnPageMs < MIN_TIME_ON_PAGE_MS ||
					fillMs < MIN_FORM_FILL_MS ||
					looksLikeJunkPhone(phoneDigits);
				const qualified =
					isQualifiedLead(payload.interest ?? "", payload.enroll ?? "") && !looksBotlike;

				try {
					sessionStorage.setItem("markaz:lead-qualified", qualified ? "1" : "0");
				} catch {
					// Private mode, or storage refused. Lead still fires on the next
					// page; only the qualified split is lost.
				}

				/*
					Advanced Matching for check-email.astro: a hashed email and phone,
					computed here (client-side SHA-256, never sent or stored in the
					clear) and handed over the same way as the qualified flag above.
					Sent for every successful signup, not just qualified ones — this
					is about improving Event Match Quality for Lead too, not only
					Qualified_Lead. See the comment on checkEmailPixelJs in
					check-email.astro for what this unlocks.
				*/
				try {
					const emailHash = await sha256Hex(payload.email.trim().toLowerCase());
					sessionStorage.setItem("markaz:em", emailHash);
					if (phoneDigits) {
						sessionStorage.setItem("markaz:ph", await sha256Hex(phoneDigits));
					}
				} catch {
					// No Web Crypto, private mode, or storage refused — Advanced
					// Matching is skipped for this signup; the registration itself,
					// and the Lead/Qualified_Lead events, are unaffected.
				}

				/*
					Straight to /check-email, which is the only place that tells them
					the registration is not finished until they click the link in
					their inbox. The button is left disabled and still reading
					"Sending..." on purpose: re-enabling it invites a second
					submission during the moment before the new page paints.

					Only on success. Every failure above returns before this point
					and leaves the visitor on the form with the reason.
				*/
				form.reset();
				window.location.assign("/check-email");
				return;
			} catch (err) {
				clearTimeout(timeoutTimer);
				const timedOut = err instanceof DOMException && err.name === "AbortError";
				done(
					"error",
					timedOut
						? "That's taking too long. Please check your connection and try again."
						: "Could not reach the server. Please check your connection and try again.",
				);
			}
		});
	}
</script>

